App(
    appid="badusb_msc",
    name="BadUSB MSC",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="bad_usb_app",
    requires=["gui", "dialogs", "storage"],
    stack_size=6 * 1024,
    fap_icon="icon.png",
    fap_icon_assets="icons",
    # Keyboard .kl tables are embedded into the FAP and auto-installed on start.
    fap_category="USB",
    fap_author="ZombieDolphin",
    fap_description="BadUSB scripts and isolated USB Mass Storage",
    fap_version="0.1",
    fap_libs=["assets", "ble_profile"],
)
